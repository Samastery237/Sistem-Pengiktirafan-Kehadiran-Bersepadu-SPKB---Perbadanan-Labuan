# ==============================================================================
# SPKB PRODUCTION ENVIRONMENT SETTINGS
# ==============================================================================
# Copy this file to '.env' on your production server.
# This configuration will pass the `python manage.py check --deploy` security audit.

# 1. CORE SECURITY
# Replace this with a strong, randomly generated 50+ character string.
# (e.g. run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY=replace-me-with-a-very-long-secure-random-string

# Must be False in production! Prevents leaking stack traces and source code.
DJANGO_DEBUG=False

# 2. HOSTING & DOMAINS
# List of valid domains that can serve the Django API
DJANGO_ALLOWED_HOSTS=api.pl.gov.my,pl.gov.my,127.0.0.1

# 3. CORS & CSRF (Cross-Origin Resource Sharing)
# List the exact domains of your frontend application
DJANGO_CORS_ALLOWED_ORIGINS=https://spkb.pl.gov.my,https://www.pl.gov.my

# ==============================================================================
# SSL & HTTPS SETTINGS (Configure in settings.py when these are True)
# ==============================================================================
# When deploying to a real server with an SSL certificate, uncomment these 
# in settings.py to clear the final deployment warnings:
# 
# SECURE_SSL_REDIRECT = True
# SESSION_COOKIE_SECURE = True
# CSRF_COOKIE_SECURE = True
# SECURE_HSTS_SECONDS = 31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS = True
# SECURE_HSTS_PRELOAD = True
# ==============================================================================
