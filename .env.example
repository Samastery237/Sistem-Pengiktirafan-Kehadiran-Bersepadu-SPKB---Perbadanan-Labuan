# Django Settings for SPKB Production
# Copy this file to .env and fill in your actual values

# SECRET_KEY - generate a strong secret key
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-here-at-least-50-characters

# Debug mode - SET TO FALSE IN PRODUCTION
DJANGO_DEBUG=False

# Allowed hosts - comma-separated list of domains/IPs
# Example: DJANGO_ALLOWED_HOSTS=spkb.pl.gov.my,www.spkb.pl.gov.my,123.456.789.0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins - comma-separated list
# Example: DJANGO_CORS_ALLOWED_ORIGINS=https://spkb.pl.gov.my,https://www.spkb.pl.gov.my
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database settings (if using PostgreSQL/MySQL instead of SQLite)
# DJANGO_DB_NAME=your_database_name
# DJANGO_DB_USER=your_database_user
# DJANGO_DB_PASSWORD=your_database_password
# DJANGO_DB_HOST=your_database_host
# DJANGO_DB_PORT=5432